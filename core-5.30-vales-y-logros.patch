+
+  it("canjear (a mano) ya no deja el saldo negativo", async () => {
+    await ponerPuntos(s.Movimiento, 30);
+    await rechaza(s.f.canjear({ empresaId: EMP, actor: MESERO, clienteId: CLI, puntos: 31 }), "SALDO_INSUFICIENTE");
