+const rechaza = (fn, re) => assert.throws(fn, (e) => e instanceof ErrorFidelizacion && e.codigo && (!re || re.test(e.message)));
+
+describe("validarBeneficio", () => {
+  const base = { nombre: " Café gratis ", puntos: 100, tipo: "item_gratis", itemCodigo: "CAFE" };
