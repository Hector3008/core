+    assert.equal(validarPromocion({ ...dos, dias: [] }).dias, null);
+    malo(() => validarPromocion({ ...dos, dias: [7] }), "dias");
+    malo(() => validarPromocion({ ...dos, dias: "lunes" }), "dias");
