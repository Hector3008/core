+
+  it("horario: HH:MM de 24 horas, distintos", () => {
+    assert.deepEqual(validarPromocion({ ...dos, horario: { desde: "18:00", hasta: "20:30" } }).horario, { desde: "18:00", hasta: "20:30" });
