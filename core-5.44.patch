+function crearMundo() {
+  const propias = (filas) => filas.filter((f) => f.empresaId === empresaActual());
+  const cumple = (d, f) =>
+    Object.entries(f).every(([k, v]) => {
+      if (v && typeof v === "object" && !(v instanceof Date)) {
+        if ("$lte" in v && !(d[k] <= v.$lte)) return false;
