+    const mala = await llamar(m, "google", req({ body: { credencial: "x" } }));
+    assert.deepEqual([mala.statusCode, mala.body.codigo], [401, "GOOGLE_INVALIDO"]);
+  });
+  it("sin sesión, `yo` dice el Client ID solo si Google está activado", async () => {
