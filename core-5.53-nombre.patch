diff --git a/test/cuentas-nombre.test.js b/test/cuentas-nombre.test.js
new file mode 100644
index 0000000..f113e0e
--- /dev/null
+++ b/test/cuentas-nombre.test.js
@@ -0,0 +1,201 @@
+// El cliente edita su propio nombre (5.53). Sin base de datos: almacenes falsos en memoria. Se prueba el servicio y
+// el manejador HTTP (con la cookie de una sesión real abierta por el registro).
+import { describe, it, beforeEach } from "node:test";
+import assert from "node:assert/strict";
+import { crearServicioCuentasCliente } from "../src/cuentas/index.js";
+import { validarNombre } from "../src/clientes/validacion.js";
+import { ErrorCliente } from "../src/clientes/errores.js";
+import { ErrorAuth } from "../src/auth/errores.js";
+import { conEmpresa, empresaActual } from "../src/tenancy.js";
+
+const E1 = "aaaaaaaaaaaaaaaaaaaaaaa1";
+const E2 = "aaaaaaaaaaaaaaaaaaaaaaa2";
+const MESERO = { usuarioId: "0123456789abcdef01234568", permisos: ["cliente:leer", "cliente:crear", "cliente:cuenta"] };
+
+const rechaza = (p, Clase, codigo, status) =>
+  assert.rejects(p, (e) => e instanceof Clase && e.codigo === codigo && (status === undefined || e.status === status), `${Clase.name} ${codigo}`);
+
+function crearMundo() {
+  let n = 0;
+  const docs = [];
+  const sesiones = [];
+  const propios = (arr) => arr.filter((d) => d.empresaId === empresaActual());
+  const coincide = (d, f) => Object.entries(f).every(([k, v]) => k.split(".").reduce((o, p) => o?.[p], d) === v || String(k.split(".").reduce((o, p) => o?.[p], d)) === String(v));
+  const poner = (d, k, v) => {
+    const ps = k.split(".");
+    let o = d;
+    for (const p of ps.slice(0, -1)) o = o[p] ??= {};
+    o[ps.at(-1)] = v;
+  };
+  const consulta = (fn) => {
+    const q = { _sel: "" };
+    q.lean = () => q;
+    q.select = (s) => ((q._sel = s), q);
+    q.then = (ok, ko) => Promise.resolve().then(() => { const r = fn(); return r ? structuredClone(r) : r; }).then(ok, ko);
+    return q;
+  };
+  const Cliente = {
+    docs,
+    findById: (id) => consulta(() => propios(docs).find((d) => d._id === String(id)) ?? null),
+    findOne: (f) => consulta(() => propios(docs).find((d) => coincide(d, f)) ?? null),
+    async updateOne(f, u) {
+      const d = propios(docs).find((x) => coincide(x, f));
+      if (!d) return { matchedCount: 0 };
+      for (const [k, v] of Object.entries(u.$set ?? {})) poner(d, k, structuredClone(v));
+      return { matchedCount: 1 };
+    },
+  };
+  const SesionCliente = {
+    docs: sesiones,
+    async create(doc) {
+      const s = { _id: String(++n).padStart(24, "s"), empresaId: empresaActual(), ...structuredClone(doc) };
+      sesiones.push(s);
+      return { ...s };
+    },
+    findOne: (f) => consulta(() => {
+      const s = propios(sesiones).find((x) => x.tokenHash === f.tokenHash);
+      if (!s) return null;
+      const c = docs.find((d) => d._id === String(s.clienteId));
+      return { ...s, $locals: { cliente: c } };
+    }),
+    init: async () => {},
+  };
+  const Empresa = { findById: (id) => consulta(() => ({ _id: String(id), activa: true, pais: "PE" })) };
+  const actualizaciones = [];
+  const clientes = {
+    async crear({ empresaId, actor, nombre, correo }) {
+      if (!actor.permisos.includes("cliente:crear")) throw new ErrorCliente("PERMISO_INSUFICIENTE", "sin permiso");
+      return conEmpresa(empresaId, async () => {
+        const d = { _id: String(++n).padStart(24, "c"), empresaId, nombre: nombre.trim(), telefono: null, correo: correo?.toLowerCase() ?? null, activo: true, anonimizadoTs: null, cuenta: null, consentimientos: { programaPuntos: null } };
+        docs.push(d);
+        return { id: d._id, nombre: d.nombre, telefono: null, correo: d.correo };
+      });
+    },
+    async obtener({ empresaId, clienteId }) {
+      const d = docs.find((x) => x._id === String(clienteId) && x.empresaId === String(empresaId));
+      return { id: d._id, nombre: d.nombre, correo: d.correo, telefono: d.telefono, consentimientos: { programaPuntos: { otorgado: !!d.consentimientos.programaPuntos?.otorgado } } };
+    },
+    // Como el real: exige `cliente:editar`, no deja tocar a un anonimizado y solo cambia lo que llega.
+    async actualizar({ empresaId, actor, clienteId, ...campos }) {
+      actualizaciones.push({ actor, campos });
+      if (!actor.permisos.includes("cliente:editar")) throw new ErrorCliente("PERMISO_INSUFICIENTE", "permiso insuficiente (cliente:editar)");
+      const d = docs.find((x) => x._id === String(clienteId) && x.empresaId === String(empresaId));
+      if (d.anonimizadoTs) throw new ErrorCliente("ESTADO_INVALIDO", "el cliente está anonimizado");
+      for (const [k, v] of Object.entries(campos)) if (v !== undefined) d[k] = v;
+      return clientes.obtener({ empresaId, clienteId });
+    },
+    async cambiarConsentimiento() {},
+  };
+  const fidelizacion = { resumen: async () => ({ habilitada: true, saldo: 0, movimientos: [] }) };
+  const auth = { exigirCsrf: (req) => { if (req.method !== "GET" && !req.headers?.["x-requested-with"]) throw new ErrorAuth("CSRF", "falta la cabecera x-requested-with"); } };
+  const servicio = crearServicioCuentasCliente({ Empresa, Cliente, SesionCliente }, auth, clientes, fidelizacion, {});
+  const empresas = { [E1]: { id: E1, slug: "uno" }, [E2]: { id: E2, slug: "dos" } };
+  const h = servicio.manejadores({ empresaDe: async (req) => empresas[req.empresa] });
+  /** Ejecuta un manejador y devuelve { status, cuerpo, cabeceras, error }. */
+  const llamar = async (nombre, { empresa = E1, cuerpo = {}, cookie = "", csrf = true } = {}) => {
+    const req = { method: "POST", empresa, body: cuerpo, ip: "1.1.1.1", headers: { cookie, ...(csrf ? { "x-requested-with": "fetch" } : {}) } };
+    const r = { status: 0, cuerpo: null, cabeceras: {}, error: null };
+    const res = { setHeader: (k, v) => (r.cabeceras[k] = v), status(c) { r.status = c; return this; }, json(c) { r.cuerpo = c; return this; } };
+    await conEmpresa(empresa, () => h[nombre](req, res, (e) => (r.error = e)));
+    return r;
+  };
+  /** Registra una cuenta con contraseña y devuelve la cookie de su sesión. */
+  const entrar = async (extra = {}, empresa = E1) => {
+    const r = await llamar("registro", { empresa, cuerpo: { nombre: "H", correo: "h@gmail.com", password: "una-clave-larga-123", ...extra } });
+    assert.equal(r.status, 201, JSON.stringify(r));
+    return String(r.cabeceras["Set-Cookie"]).split(";")[0];
+  };
+  return { servicio, docs, clientes, actualizaciones, llamar, entrar };
+}
+
+describe("cambiar mi nombre: servicio", () => {
+  let m;
+  beforeEach(() => (m = crearMundo()));
+  const ficha = () => m.clientes.crear({ empresaId: E1, actor: MESERO, nombre: "H", correo: "h@gmail.com" });
+  const cambiar = (nombre, clienteId, e = E1) => conEmpresa(e, () => m.servicio.cambiarMiNombre({ empresaId: e, clienteId, nombre }));
+
+  it("cambia el nombre de la ficha y devuelve el nombre ya limpio", async () => {
+    const c = await ficha();
+    assert.deepEqual(await cambiar("  Héctor  ", c.id), { nombre: "Héctor" });
+    assert.equal(m.docs[0].nombre, "Héctor");
+  });
+  it("solo manda el nombre: nada más de la ficha se toca, y lo hace con el permiso mínimo para editar", async () => {
+    const c = await ficha();
+    await cambiar("Héctor", c.id);
+    assert.equal(m.actualizaciones.length, 1);
+    assert.deepEqual(Object.keys(m.actualizaciones[0].campos), ["nombre"]);
+    assert.deepEqual(m.actualizaciones[0].actor.permisos, ["cliente:editar"]);
+    assert.equal(m.docs[0].correo, "h@gmail.com");
+  });
+  it("rechaza un nombre vacío, de solo espacios, demasiado largo o que no es texto (y no cambia nada)", async () => {
+    const c = await ficha();
+    for (const malo of ["", "   ", "x".repeat(81), null, undefined, 42, { a: 1 }, ["H"]])
+      await rechaza(cambiar(malo, c.id), ErrorCliente, "DATOS_INVALIDOS", 400);
+    assert.equal(m.docs[0].nombre, "H");
+    assert.equal(m.actualizaciones.length, 0, "ni siquiera llega a la ficha");
+  });
+  it("acepta justo 80 caracteres", async () => {
+    const c = await ficha();
+    assert.equal((await cambiar("x".repeat(80), c.id)).nombre.length, 80);
+  });
+  it("una ficha anonimizada no se puede editar", async () => {
+    const c = await ficha();
+    m.docs[0].anonimizadoTs = new Date();
+    await rechaza(cambiar("Héctor", c.id), ErrorCliente, "ESTADO_INVALIDO");
+  });
+  it("el validador es el mismo que usa el personal", () => {
+    assert.equal(validarNombre("  Ana  "), "Ana");
+    assert.throws(() => validarNombre("x".repeat(81)), ErrorCliente);
+  });
+});
+
+describe("cambiar mi nombre: manejador HTTP", () => {
+  let m;
+  beforeEach(() => (m = crearMundo()));
+
+  it("con sesión cambia el nombre y devuelve la cuenta ya con el nombre nuevo", async () => {
+    const cookie = await m.entrar();
+    const r = await m.llamar("nombre", { cookie, cuerpo: { nombre: "Héctor" } });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.cliente.nombre, "Héctor");
+    assert.equal(r.cuerpo.cliente.correo, "h@gmail.com");
+    assert.equal(m.docs[0].nombre, "Héctor");
+    assert.equal(r.cabeceras["Cache-Control"], "no-store");
+  });
+  it("sin sesión (o con una cookie falsa) responde 401 y no cambia nada", async () => {
+    await m.entrar();
+    for (const cookie of ["", "otra=1", "tobt_cliente_uno=falsa"]) {
+      const r = await m.llamar("nombre", { cookie, cuerpo: { nombre: "Intruso" } });
+      assert.equal(r.status, 401);
+      assert.equal(r.cuerpo.codigo, "SIN_SESION");
+    }
+    assert.equal(m.docs[0].nombre, "H");
+  });
+  it("sin la cabecera anti-CSRF no cambia nada", async () => {
+    const cookie = await m.entrar();
+    const r = await m.llamar("nombre", { cookie, csrf: false, cuerpo: { nombre: "Intruso" } });
+    assert.ok(r.error instanceof ErrorAuth || r.status >= 400, JSON.stringify(r));
+    assert.equal(m.docs[0].nombre, "H");
+  });
+  it("un nombre inválido responde 400", async () => {
+    const cookie = await m.entrar();
+    for (const cuerpo of [{ nombre: "" }, { nombre: "x".repeat(81) }, {}, { nombre: 7 }]) {
+      const r = await m.llamar("nombre", { cookie, cuerpo });
+      assert.equal(r.status, 400, JSON.stringify(cuerpo));
+    }
+    assert.equal(m.docs[0].nombre, "H");
+  });
+  it("solo cambia a quien tiene la sesión: no se puede mandar el id de otro en el cuerpo", async () => {
+    const cookieA = await m.entrar({ correo: "a@gmail.com", nombre: "Ana" });
+    await m.entrar({ correo: "b@gmail.com", nombre: "Beto" });
+    const r = await m.llamar("nombre", { cookie: cookieA, cuerpo: { nombre: "Nuevo", clienteId: m.docs[1]._id, id: m.docs[1]._id } });
+    assert.equal(r.status, 200);
+    assert.deepEqual(m.docs.map((d) => d.nombre), ["Nuevo", "Beto"]);
+  });
+  it("la cookie de una empresa no vale en otra", async () => {
+    const cookie = await m.entrar();
+    const r = await m.llamar("nombre", { empresa: E2, cookie, cuerpo: { nombre: "Intruso" } });
+    assert.equal(r.status, 401);
+    assert.equal(m.docs[0].nombre, "H");
+  });
+});
