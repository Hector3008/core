+  it("aislada por empresa y paginada", async () => {
+    await m.guardar(C1, { estrellas: 5 });
+    await m.guardar(C2, { estrellas: 4 });
+    assert.equal((await ver({}, E2)).total, 0);
+    const p = await ver({ limite: 1 });
+    assert.equal(p.resenas.length, 1);
