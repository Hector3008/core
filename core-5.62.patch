+  it("una ficha anonimizada sale como Anónimo", async () => {
+    m.pagados.add(`${E1}|${C3}|Moka`);
+    await m.guardar(C3, { estrellas: 4 });
+    assert.equal((await ver()).resenas[0].autor, "Anónimo");
